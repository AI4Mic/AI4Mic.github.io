---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import TopNav from '../components/TopNav.astro';
import Hero from '../components/Hero.astro';
import Timeline from '../components/Timeline.astro';
import Organisers from '../components/Organisers.astro';
import Faq from '../components/Faq.astro';
import Schedule from '../components/Schedule.astro';
import Speakers from '../components/Speakers.astro';
import Footer from '../components/Footer.astro';
import Logos from '../components/Logos.astro';
import { getOrganisers, getFaq, getSchedule, getSpeakers } from '../lib/content';

const event = (await getCollection('event')).at(0)?.data;
if (!event) throw new Error('event.yaml missing or invalid');
const teams = getOrganisers();
const faq = getFaq();
const schedule = getSchedule();
const speakers = getSpeakers();
const applyHref = event.applications.url !== '' ? event.applications.url : '#dates';
---
<Base
  title={`${event.title} · ${event.subtitle}`}
  description={event.subtitle}
  event={event}
  organiserNames={teams.map((t) => t.institution)}
>
  <TopNav shortName={event.shortName} applyHref={applyHref} />
  <main id="main">
    <Hero event={event} />

    <section id="about" class="section">
      <h2>About</h2>
      <p>{event.intro}</p>
      <p>{event.audience}</p>
    </section>

    <section id="learn" class="section">
      <h2>What you will learn</h2>
      <div class="grid cards">
        {event.learn.map((item) => (
          <article class="card">
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </article>
        ))}
      </div>
    </section>

    <section id="programme" class="section">
      <h2>Programme</h2>
      <Schedule schedule={schedule} />
    </section>

    <section id="speakers" class="section">
      <h2>Speakers</h2>
      <Speakers speakers={speakers} teams={teams} />
    </section>

    <section id="dates" class="section">
      <h2>Key dates</h2>
      <Timeline items={event.timeline} />
    </section>

    <section id="apply" class="section">
      <h2>How to apply</h2>
      <p>{event.applications.text}</p>
      <ul>{event.applications.needs.map((n) => <li>{n}</li>)}</ul>
      {event.applications.url !== '' && <p><a class="btn btn-primary" href={event.applications.url}>Apply</a></p>}
    </section>

    <section id="fees" class="section">
      <h2>Registration fees</h2>
      <p class="currency"><label>Show fees in
        <select id="fee-currency">
          {Object.keys(event.fees.rates).map((c) => <option value={c}>{c}</option>)}
        </select></label>
      </p>
      <table class="fees">
        <thead><tr><th>Attendance</th><th>Standard fee</th><th>Table C countries*</th></tr></thead>
        <tbody>
          {event.fees.rows.map((r) => <tr><td>{r.attendance}</td><td data-eur={r.standard}>€{r.standard}</td><td data-eur={r.tableC}>€{r.tableC}</td></tr>)}
        </tbody>
      </table>
      <p class="footnote" id="fee-rate-note" hidden>Amounts in other currencies are approximate, at the European Central Bank rate of {event.fees.ratesDate}.</p>
      <ul>{event.fees.notes.slice(0, -1).map((n) => <li set:html={n} />)}</ul>
      <p class="footnote">* <Fragment set:html={event.fees.notes.at(-1)} /></p>
      <script is:inline define:vars={{ rates: event.fees.rates }}>
        const sel = document.getElementById('fee-currency');
        sel.addEventListener('change', () => {
          const c = sel.value;
          const fmt = new Intl.NumberFormat('en-GB', { style: 'currency', currency: c, currencyDisplay: 'narrowSymbol', maximumFractionDigits: 0 });
          // Round rand to the nearest 10; other currencies to whole units.
          const step = c === 'ZAR' ? 10 : 1;
          document.querySelectorAll('.fees td[data-eur]').forEach((td) => {
            td.textContent = fmt.format(Math.round((td.dataset.eur * rates[c]) / step) * step);
          });
          document.getElementById('fee-rate-note').hidden = c === 'EUR';
        });
      </script>
    </section>

    <section id="fellowships" class="section">
      <h2>{event.fellowships.heading}</h2>
      <p>{event.fellowships.text}</p>
      <ul>{event.fellowships.tiers.map((t) => <li><strong>{t.name}</strong> {t.text}</li>)}</ul>
      {event.fellowships.notes.map((n) => <p>{n}</p>)}
    </section>

    <section id="venue" class="section">
      <h2>Venue and travel</h2>
      <p>{event.venue.campus} <a href={event.venue.map} rel="noopener">Map</a></p>
      {event.travel.map((t) => (
        <Fragment>
          <h3>{t.title}</h3>
          <p set:html={t.text} />
        </Fragment>
      ))}
      <h3>Accessibility</h3>
      <p>{event.accessibility} Email <a href={`mailto:${event.contact}`}>{event.contact}</a>.</p>
      <h3>Cancellation policy</h3>
      {event.cancellation.map((c) => (
        <p><strong>{c.name}:</strong> {c.text}</p>
      ))}
    </section>

    <section id="organisers" class="section">
      <h2>Organisers</h2>
      <Organisers teams={teams} />
    </section>

    <section id="faq" class="section">
      <h2>FAQ</h2>
      <Faq items={faq} />
    </section>
    <Logos teams={teams} funders={event.funders} />
  </main>
  <Footer event={event} />
</Base>
