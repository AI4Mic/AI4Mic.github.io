---
import type { Speakers, Team, SpeakerEntry } from '../lib/content';

interface Props {
  speakers: Speakers;
  teams: Team[];
}
const { speakers, teams } = Astro.props;
const people = new Map(teams.flatMap((t) => t.people.map((p) => [p.name, { ...p, institution: t.institution }] as const)));
const resolve = (list: SpeakerEntry[]) =>
  list.map((s) => {
    const p = people.get(s.name);
    if (!p && !s.institution) throw new Error(`speakers.yaml: ${s.name} is not in organisers.yaml and has no institution`);
    return { ...p, ...s, institution: s.institution ?? p!.institution };
  });
const groups = [
  { title: 'Invited speakers', list: resolve(speakers.invited) },
  { title: 'Faculty', list: resolve(speakers.faculty) },
];
---
<p class="provisional"><strong>Provisional.</strong> {speakers.note}</p>
{groups.map((g) => (
  <Fragment>
    <h3 class="speakers-heading">{g.title}</h3>
    <div class="grid cards speakers">
      {g.list.map((s) => (
        <article class="card speaker">
          {s.photo && <img class="avatar-img" src={s.photo} alt="" width="56" height="56" loading="lazy" />}
          <div>
            <h3>{s.url ? <a href={s.url} rel="noopener">{s.name}</a> : s.name}</h3>
            <p class="speaker-inst">{s.institution}</p>
            <p>{s.talk}</p>
          </div>
        </article>
      ))}
    </div>
  </Fragment>
))}
