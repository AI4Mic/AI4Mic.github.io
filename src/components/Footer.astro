---
import type { CollectionEntry } from 'astro:content';

interface Props {
  event: CollectionEntry<'event'>['data'];
}
const { event } = Astro.props;
---
<footer class="footer">
  <p class="funders">
    {event.funders.map((f, i) => (
      <Fragment>
        {i > 0 && ' · '}
        <a href={f.url} rel="noopener">{f.name}</a>
      </Fragment>
    ))}
  </p>
  <p>{event.note}</p>
  <p>
    Questions: <a href="mailto:caron.jacobs@uct.ac.za">caron.jacobs@uct.ac.za</a> · <a href="/code-of-conduct/">Code of conduct</a>
  </p>
  <p>
    <a href="https://github.com/AI4Mic/AI4Mic.github.io" rel="noopener">GitHub repository</a> · Website by the organising teams
  </p>
</footer>
